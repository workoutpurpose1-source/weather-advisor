# -----------------------------------------------------------------------
# HOW TO USE THIS FILE:
# 1. Copy this file and rename the copy to ".env" (remove ".example")
# 2. Fill in your real API keys below
# 3. Never share your real .env file publicly (it holds secret keys)
# -----------------------------------------------------------------------

# Get a free key at https://openweathermap.org/api
OPENWEATHER_API_KEY=your_openweather_api_key_here

# Get a free key at https://aistudio.google.com/app/apikey
# (Optional) If you leave this blank, the app will still work using
# a built-in rule-based advisor instead of Gemini AI.
GEMINI_API_KEY=your_gemini_api_key_here
